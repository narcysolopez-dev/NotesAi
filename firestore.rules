rules_version = '2';

// Reglas de seguridad de Cloud Firestore para NotesAi.
// Copia y pega este archivo en Firebase Console > Firestore Database > Reglas > Publicar.
//
// Cada usuario autenticado solo puede leer y escribir sus propias notas,
// guardadas en users/{uid}/notes/{noteId}. Todo lo demás queda denegado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
